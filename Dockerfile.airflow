FROM apache/airflow:3.3.2-python3.12

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/spark-conf \
    && printf '%s\n' \
        'spark.master                          local[*]' \
        'spark.hadoop.fs.s3a.endpoint          http://minio:9000' \
        'spark.hadoop.fs.s3a.endpoint.region   us-east-1' \
        'spark.hadoop.fs.s3a.path.style.access true' \
        'spark.driver.memory                   2g' \
        'spark.sql.shuffle.partitions          8' \
        > /opt/spark-conf/spark-defaults.conf
USER airflow

COPY requirements.airflow.txt /tmp/requirements.airflow.txt
RUN pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" -r /tmp/requirements.airflow.txt

ARG HADOOP_AWS_VERSION=3.5.0
ARG AWS_SDK_VERSION=2.35.4
ARG ANALYTICS_ACCELERATOR_VERSION=1.3.1
RUN SPARK_JARS="$(python -c 'import os, pyspark; print(os.path.join(os.path.dirname(pyspark.__file__), "jars"))')" \
    && curl -fsSL -o "${SPARK_JARS}/hadoop-aws-${HADOOP_AWS_VERSION}.jar" \
        "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/${HADOOP_AWS_VERSION}/hadoop-aws-${HADOOP_AWS_VERSION}.jar" \
    && curl -fsSL -o "${SPARK_JARS}/bundle-${AWS_SDK_VERSION}.jar" \
        "https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/${AWS_SDK_VERSION}/bundle-${AWS_SDK_VERSION}.jar" \
    && curl -fsSL -o "${SPARK_JARS}/analyticsaccelerator-s3-${ANALYTICS_ACCELERATOR_VERSION}.jar" \
        "https://repo1.maven.org/maven2/software/amazon/s3/analyticsaccelerator/analyticsaccelerator-s3/${ANALYTICS_ACCELERATOR_VERSION}/analyticsaccelerator-s3-${ANALYTICS_ACCELERATOR_VERSION}.jar"

ENV SPARK_CONF_DIR=/opt/spark-conf
